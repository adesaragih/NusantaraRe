# Salin menjadi .env lalu isi. Berkas .env tidak pernah masuk git.
# Vite membaca .env sendiri saat `npm run dev` dan `npm run build`.

# Alamat backend yang dipanggil browser. Kosong berarti sama-asal
# (frontend di belakang proxy yang sama).
VITE_API_BASE_URL=

# Tujuan proxy SAAT DEV saja: alamat backend Go, misalnya port yang sama dengan
# HTTP_ADDR di ../.env. Kosong = tanpa proxy. Tanpa awalan VITE_, jadi tidak
# pernah ikut ke bundel browser. Lihat vite.config.ts.
DEV_PROXY_TARGET=

# Masuk lewat STUB (F0.2). `true` menyalakan layar masuk yang memilih akun dan
# peran tanpa sandi, lalu mengirimnya sebagai header X-Pelaku / X-Peran.
#
# Nilai selain `true` - termasuk TIDAK DISETEL - berarti MATI: layar masuk
# menolak memberi jalan. Gagal tertutup, bukan gagal terbuka.
#
# Backend punya saklarnya sendiri (stubPelaku); keduanya harus menyala supaya
# identitasnya dipercaya. IAM sungguhan = tiket 07 / ADR-U-0030.
VITE_AUTH_STUB=

# Identitas pelaku stub (F0.6 - form login ditiadakan).
#
# Dipakai HANYA bila VITE_AUTH_STUB=true. Akun kosong jatuh ke UJI-ADMIN;
# peran kosong jatuh ke KETIGA peran ADR-U-0002 - pengembang yang menyalakan
# stub hampir selalu ingin melihat seluruh antrian.
#
# Peran dipisah KOMA, persis yang handlers/pelaku.go urai. Peran yang tidak
# dikenal dibuang di layar sebelum dikirim.
VITE_STUB_PELAKU=
VITE_STUB_PERAN=
