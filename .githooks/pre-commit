#!/bin/sh
# Penjaga wilayah cabang - lapis lokal (cepat, bisa dilewati --no-verify).
# Cabang module/<nama> hanya boleh menyentuh folder modulnya sendiri.
# dev, main, inti/*, perbaikan/* tidak dibatasi.
# Penjaga yang mengikat ada di .github/workflows/penjaga-wilayah-cabang.yml.

cabang=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0

case "$cabang" in
  module/*) ;;
  *) exit 0 ;;
esac

nama=${cabang#module/}
nama=${nama%%/*}

gen="APP_RNM/inti/backend/daftar/modul_${nama}_gen.go"

pelanggar=$(git diff --cached --name-only --diff-filter=ACMRD \
  | grep -v "^APP_RNM/modul/${nama}/" \
  | grep -vx "${gen}")

[ -z "$pelanggar" ] && exit 0

echo ""
echo "  COMMIT DITOLAK - cabang '${cabang}' keluar wilayah modul '${nama}'."
echo ""
echo "  Berkas di luar wilayah:"
echo "$pelanggar" | sed 's/^/      /'
echo ""
echo "  Wilayah yang boleh disentuh cabang ini:"
echo "      APP_RNM/modul/${nama}/"
echo "      ${gen}"
echo ""
echo "  Perubahan berkas bersama masuk lewat cabang tersendiri:"
echo "      git switch dev && git switch -c inti/<topik>"
echo "  Lihat APP_RNM/PANDUAN-CABANG-GIT.md bab 4."
echo ""
echo "  Keluarkan dulu dari staging:"
echo "$pelanggar" | sed 's|^|      git restore --staged "|; s|$|"|'
echo ""
exit 1
