# Konfigurasi lokal backend Nusantara Re - mesin ini saja.
#
# Berkas ini TIDAK masuk git (pola *.env di .gitignore akar repositori).
# Backend Go tidak membaca berkas ini sendiri. Muat ke sesi PowerShell dengan:
#
#   . .\muat-env.ps1
#
# (titik, spasi, lalu nama skrip - namanya "dot-source", supaya variabelnya
# tetap hidup di jendela itu sesudah skrip selesai).
#
# <sandi> sengaja dibiarkan kosong: muat-env.ps1 menanyakannya saat dimuat,
# tanpa menampilkan dan tanpa menulisnya ke mana pun. Bila Anda memutuskan
# menyimpan sandi di sini, ganti <sandi> dengan sandinya; skrip tetap jalan.

HTTP_ADDR=:8080
ORACLE_DSN=oracle://POOLDATA:POOLDATA12@192.168.122.100:1521/DEV_NUSARE2
ORACLE_SCHEMA=POOLDATA
IS_PEGA_PROD=false
AUTH_STUB=false
SESI_COOKIE_SECURE=true
SESI_RAHASIA=dHnwHU6Z1ml-QAuIsbfWtV34zYqtqcub7TTB9ff1ogBygDF4ZqaN8kxwn2bmrEhm
# Untuk `go test -tags=db` dan `-migrate`: skema uji HARUS skema KOSONG yang
# dibuat DBA khusus, bukan POOLDATA (test db menghapus tabel di skema yang
# ditunjuk). Bila skema itu sudah ada, ganti ORACLE_SCHEMA di atas dan buka
# dua baris di bawah ini:
# ORACLE_SKEMA_UJI=true

# folder lokal untuk berkas unggahan dokumen (keputusan be); bukan korpus, tidak masuk git
UNGGAHAN_DIR=D:\XML\RNM_BRD\OUTPUT_HASIL_RNM\APP_RNM\unggahan