# Salin menjadi .env lalu isi. Berkas .env tidak pernah masuk git.
# Nol nilai sungguhan di berkas ini: nol DSN, nol kata sandi, nol host.
HTTP_ADDR=:8080
ORACLE_DSN=
# Nama skema uji dari DBA. TANPA bawaan: sampai 26-09-2026 baris ini berbunyi
# POOLDATA, nama skema warisan Pega, dan `go test -tags=db` menghapus tabel di
# skema yang ditunjuk.
ORACLE_SCHEMA=
IS_PEGA_PROD=false
# Pengakuan sadar bahwa skema di atas boleh dihapus isinya. Hanya dibaca test
# bertag db, yang menolak berjalan tanpa ini - dan menolak POOLDATA meski ada.
ORACLE_SKEMA_UJI=
# Alamat layanan luar: SERVICE_<NAMA>=<alamat>

# --------------------------------------------------------------- identitas
# Gerbang identitas SEMENTARA, sampai IAM terpasang. Hanya `true` PERSIS yang
# menyalakannya; apa pun yang lain - termasuk tidak disetel - berarti MATI.
#
# Bila MATI, backend mengabaikan header `X-Pelaku`/`X-Peran` dan menjawab 401
# untuk setiap jalur beridentitas. Layar tetap menyala, tetapi Inbox tampak
# KOSONG - dan kosong itu terbaca "tidak ada pekerjaan", bukan "ditolak".
#
# ⚠️ Nyalakan BERSAMA `frontend/.env` `VITE_AUTH_STUB=true`. Menyalakan salah
# satu saja menghasilkan layar kosong yang tidak menjelaskan dirinya: sisi
# React mengirim identitas yang sisi Go buang, atau sebaliknya.
#
# ⛔ Ditolak config bila IS_PEGA_PROD=true.
AUTH_STUB=false

# Garam token penyimpanan dokumen.
#
# ⛔ NILAINYA TIDAK PERNAH DITULIS DI SINI, di repo, atau di percakapan. Ia
# diminta ke DBA lewat jalur rahasia, dan TIDAK PERNAH disalin dari procedure
# warisan. Yang berdiri di berkas contoh ini hanya NAMANYA.
STORAGE_TOKEN_SALT=

# Folder LOKAL tempat berkas unggahan dokumen klaim disimpan (butir be).
#
# ⛔ BUKAN folder korpus. Korpus di D:\XML\RNM_BRD\ dibaca sebagai bukti dan
# TIDAK PERNAH ditulisi; folder ini milik aplikasi.
#
# Kosong berarti unggahan GAGAL TERANG, dan itu keadaan yang benar sampai
# seseorang memilih foldernya. Tidak ada bawaan diam-diam: berkas pelanggan
# tidak boleh mendarat di folder kerja siapa pun yang kebetulan menjalankan
# server.
UNGGAHAN_DIR=
