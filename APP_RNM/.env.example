# Salin menjadi .env lalu isi. Berkas .env tidak pernah masuk git.
# Nol nilai sungguhan di berkas ini: nol DSN, nol kata sandi, nol host.
HTTP_ADDR=:8080
ORACLE_DSN=
# Nama skema uji dari DBA. TANPA bawaan: sampai 26-09-2026 baris ini berbunyi
# POOLDATA, nama skema warisan Pega, dan `go test -tags=db` menghapus tabel di
# skema yang ditunjuk.
ORACLE_SCHEMA=
IS_PEGA_PROD=false
# Pengakuan sadar bahwa skema di atas boleh dihapus isinya. Hanya dibaca test
# bertag db, yang menolak berjalan tanpa ini - dan menolak POOLDATA meski ada.
ORACLE_SKEMA_UJI=
# Alamat layanan luar: SERVICE_<NAMA>=<alamat>
