# Salin menjadi .env lalu isi. Berkas .env tidak pernah masuk git.
# Nol nilai sungguhan di berkas ini: nol DSN, nol kata sandi, nol host.
HTTP_ADDR=:8080
ORACLE_DSN=
# Nama skema uji dari DBA. TANPA bawaan: sampai 26-09-2026 baris ini berbunyi
# POOLDATA, nama skema warisan Pega, dan `go test -tags=db` menghapus tabel di
# skema yang ditunjuk.
ORACLE_SCHEMA=
IS_PEGA_PROD=false
# Pengakuan sadar bahwa skema di atas boleh dihapus isinya. Hanya dibaca test
# bertag db, yang menolak berjalan tanpa ini - dan menolak POOLDATA meski ada.
ORACLE_SKEMA_UJI=
# Alamat layanan luar: SERVICE_<NAMA>=<alamat>

# --------------------------------------------------------------- identitas
# Gerbang identitas SEMENTARA, sampai IAM terpasang. Hanya `true` PERSIS yang
# menyalakannya; apa pun yang lain - termasuk tidak disetel - berarti MATI.
#
# Bila MATI, backend mengabaikan header `X-Pelaku`/`X-Peran` dan menjawab 401
# untuk setiap jalur beridentitas. Layar tetap menyala, tetapi Inbox tampak
# KOSONG - dan kosong itu terbaca "tidak ada pekerjaan", bukan "ditolak".
#
# ⚠️ Nyalakan BERSAMA `frontend/.env` `VITE_AUTH_STUB=true`. Menyalakan salah
# satu saja menghasilkan layar kosong yang tidak menjelaskan dirinya: sisi
# React mengirim identitas yang sisi Go buang, atau sebaliknya.
#
# ⛔ Ditolak config bila IS_PEGA_PROD=true.
AUTH_STUB=false

# ------------------------------------------------------------------- login
# Kunci tanda tangan cookie sesi login (M_LOGIN_GO, keputusan work owner
# 01-10-2026). Minimal 32 karakter ACAK. Kosong = login menjawab 503.
#
# ⛔ NILAINYA TIDAK PERNAH DITULIS DI SINI, di repo, atau di percakapan.
# Membuatnya: py -c "import secrets; print(secrets.token_urlsafe(48))"
# Mengganti nilainya mencabut SEMUA sesi yang sedang berjalan.
SESI_RAHASIA=
# Atribut Secure cookie sesi. Bawaan true (localhost tetap jalan). `false`
# hanya untuk server http tanpa TLS di jaringan uji; ditolak bila
# IS_PEGA_PROD=true.
SESI_COOKIE_SECURE=true

# Garam token penyimpanan dokumen.
#
# ⛔ NILAINYA TIDAK PERNAH DITULIS DI SINI, di repo, atau di percakapan. Ia
# diminta ke DBA lewat jalur rahasia, dan TIDAK PERNAH disalin dari procedure
# warisan. Yang berdiri di berkas contoh ini hanya NAMANYA.
STORAGE_TOKEN_SALT=

# Folder LOKAL tempat berkas unggahan dokumen klaim disimpan (butir be).
#
# ⛔ BUKAN folder korpus. Korpus di D:\XML\RNM_BRD\ dibaca sebagai bukti dan
# TIDAK PERNAH ditulisi; folder ini milik aplikasi.
#
# Kosong berarti unggahan GAGAL TERANG, dan itu keadaan yang benar sampai
# seseorang memilih foldernya. Tidak ada bawaan diam-diam: berkas pelanggan
# tidak boleh mendarat di folder kerja siapa pun yang kebetulan menjalankan
# server.
UNGGAHAN_DIR=

# Pelaksana penyimpanan lampiran Treaty Contract Out (OQ-TCO-08).
#
# stub  = BAWAAN; berkas ke folder UNGGAHAN_DIR, tidak ada panggilan keluar.
# nyata = layanan penyimpanan; alamatnya dibaca dari tabel M_LINK_SERVICE saat
#         jalan (TIDAK ditulis di sini), token dirakit dengan STORAGE_TOKEN_SALT.
#         Menuntut STORAGE_TOKEN_SALT terisi - backend menolak menyala tanpanya.
# Nilai lain ditolak saat menyala.
PELAKSANA_STORAGE=stub

# Modul yang AKTIF di proses ini (refactor bentuk B), dipisah koma:
#   claimlife, premiumlistlife, komiteclaimlife, treatycontractout
# Nama LAMA (premiumlist, komite, treaty - sebelum 30-09-2026) DITOLAK saat
# menyala dengan pesan yang menyebut nama barunya.
#
# Tabel nama modul (keputusan work owner 30-09-2026, PROMPT-REFACTOR-NAMA-MODUL.md):
# Modul korpus         Backend Go modul\   Frontend src\modul\ dan .scratch\   MODUL_AKTIF
#                      (tanpa tanda hubung)
# -------------------  ------------------  ---------------------------------  -----------------
# Claim Life           claimlife (tetap)   claim-life                         claimlife
# PremiumList Life     premiumlist ->      premiumlist ->                     premiumlistlife
#                      premiumlistlife     premiumlist-life
# Komite Claim Life    komite ->           komite ->                          komiteclaimlife
#                      komiteclaimlife     komite-claim-life
# Treaty Contract Out  treaty ->           treaty ->                          treatycontractout
#                      treatycontractout   treaty-contract-out
# (modul berikutnya,   nbfacin             nb-facin                           nbfacin
#  mis. NB FacIn)
#
# Aturan: nama backend = nama dokumen .scratch tanpa tanda hubung; frontend
# memakai nama .scratch persis. Nama paket Go = nama folder.
#
# KOSONG = SEMUA modul aktif (bawaan; sama dengan sebelum variabel ini ada).
# Modul nonaktif: rutenya TIDAK didaftarkan (jawab 404), pekerja latarnya
# TIDAK jalan, dan menunya TIDAK tampil - frontend membaca daftarnya dari
# GET /api/modul-aktif, bukan dari env Vite. Nama yang tidak dikenal ditolak
# saat menyala.
#
# ⛔ Migrasi TIDAK terpengaruh: -migrate selalu menjalankan migrasi SEMUA modul
# terdaftar, supaya skema selalu utuh.
MODUL_AKTIF=

# Jeda pekerja latar antrean lampiran Treaty Contract Out (OQ-TCO-09),
# format durasi Go: 30s, 1m, 5m. Kosong atau 0 = pekerja MATI.
TCO_PEKERJA_LAMPIRAN_INTERVAL=
