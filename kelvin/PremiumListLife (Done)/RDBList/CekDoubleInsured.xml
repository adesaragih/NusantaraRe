{OutDataDetail.CARI1 out}:=nvl(v_Count ,0)+nvl(v_Count2 ,0);

{OutDataDetail.CARI2 out}:=v_Min ;

{OutDataDetail.CARI3 out}:=nvl(v_TempRetensiCeding ,0)+nvl(v_PLRetensiCeding ,0);

END;</pyBrowseSQL>
