<pyBrowseSQL>Declare

v_Count Number;
v_Count2 Number;
v_Min Number;
v_TempRetensiCeding Number;
v_PLRetensiCeding Number;
v_FinRetensiCeding Number;


BEGIN

select count(1) into v_Count from POOLDATA.M_TEMPUPLOADLIFE where upper(INSURED)={InDataDetail.CARI1} and DOB ={InDataDetail.CARI2};

select min(NO) into v_Min   from POOLDATA.M_TEMPUPLOADLIFE where upper(INSURED)={InDataDetail.CARI1} and DOB ={InDataDetail.CARI2};

