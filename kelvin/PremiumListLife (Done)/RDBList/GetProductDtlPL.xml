<pyBrowseSQL>select b.payment  as "CAUSE",a.ID,a.TYPE_CEDING,a.PRODUCTNAME,a.RIRATEID,a.RIRATE,b.CEDINGLIMIT as "OUTWARDCOMM",b.CEDINGRETENTIONNUM as "OUTWARDCOMMID",b.RNMSHARE as "OUTWARDNAME",b.MINAGE as "OUTWARDNAMEID",b.MAXAGE as "OUTWARDRATE",b.BROKERAGE as "BROKERAGE",a.OVR_COMM, a.RICOMM
