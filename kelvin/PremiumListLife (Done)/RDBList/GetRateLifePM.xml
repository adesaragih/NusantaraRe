<pyBrowseSQL>DECLARE
vCount NUMBER;

BEGIN

select count(distinct contract) into vCount  FROM rate_life a WHERE USEDBY={InData.CARI3};

 {RateQR.CARI9 out } :=vCount  ;

if vCount  &gt; 1 then

SELECT AGE ,CONTRACT , GENDER , IDUSEDBY , RATE into {RateQR.CARI1 out } ,{RateQR.CARI2 out} ,{RateQR.CARI3 out} ,{RateQR.CARI4 out} ,{RateQR.HASIL1 out}
FROM rate_life a 
WHERE USEDBY={InData.CARI3}  {ASIS:InData.CARI7} {ASIS:InData.CARI8};

elsif  vCount  =1  then

SELECT AGE ,CONTRACT , GENDER , IDUSEDBY , RATE into {RateQR.CARI5 out } ,{RateQR.CARI6 out} ,{RateQR.CARI7 out} ,{RateQR.CARI8 out} ,{RateQR.HASIL2 out}
FROM rate_life a 
WHERE USEDBY={InData.CARI3}  {ASIS:InData.CARI8};

end if;

END;</pyBrowseSQL>
